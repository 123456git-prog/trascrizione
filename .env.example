# Copia questo file come .env e compila i valori. Il file .env non va mai condiviso né caricato su GitHub.

# --- Analisi del testo ---
# Motore predefinito (il programma te lo chiede comunque ogni volta):
#   ollama = locale, gratis, lento, adatto ai dati sensibili
#   gemini = cloud Google, quota gratuita, veloce, SOLO dati non sensibili
#   claude = API di Claude, a pagamento, qualità migliore (facoltativo)
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma3:4b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high : più alto = più accurato ma più costoso
CLAUDE_EFFORT=medium

# --- Trascrizione (sempre in locale) ---
# faster-whisper (processore) | whisper-cpp (eseguibile esterno, può usare la grafica AMD)
STT_ENGINE=faster-whisper
WHISPER_MODEL=large-v3-turbo
# Nomi propri e sigle che ricorrono spesso, aiutano il riconoscimento
WHISPER_VOCABULARY=
# Solo per whisper-cpp:
WHISPER_CPP_BIN=C:\whisper\whisper-cli.exe
WHISPER_CPP_MODEL=C:\whisper\ggml-large-v3-turbo.bin

# --- Riconoscimento interlocutori (in locale) ---
# sherpa (leggero, nessun account) | pyannote (serve HF_TOKEN e requirements-diarization.txt)
DIARIZATION=true
DIARIZATION_ENGINE=sherpa
# Solo quando il numero di persone non è indicato: più alto = meno interlocutori distinti
DIARIZATION_THRESHOLD=0.4
HF_TOKEN=

# --- Server web ---
# Password per aprire l'app dal browser (consigliata se la usi dal telefono)
APP_PASSWORD=
PORT=8000

# Cartella dove vengono salvate registrazioni e analisi
DATA_DIR=data
